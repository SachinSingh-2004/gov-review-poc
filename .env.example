# Database Configuration
# Default fallback uses local SQLite or MySQL if available.
# MySQL Example: mysql+pymysql://root:password@localhost:3306/rd_governance_db
DATABASE_URL=sqlite:///./rd_governance.db

# Authentication Mode: "DEMO" or "ENTRA_ID"
AUTH_MODE=DEMO

# Microsoft Entra ID Configuration (Used when AUTH_MODE=ENTRA_ID)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=mock-entra-client-secret

# Server & CORS Configuration
API_PORT=8000
FRONTEND_URL=http://localhost:5173
SECRET_KEY=super-secret-governance-demo-key-2026-change-in-production
